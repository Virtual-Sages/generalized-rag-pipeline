# Placeholder for future pg-vector / Postgres configuration
DATABASE_URL=postgresql://user:password@localhost:5432/genrag

# --- Embedder (POC) -------------------------------------------------------
# Only read when the optional embedder dependencies are installed
# (pip install -r requirements-embed.txt). See docs/embedder-poc-analysis.md.

# HuggingFace model id. Changing this usually changes EMBEDDING_DIM too, and
# any vectors already stored under the previous model become unusable.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Must match both the model's output width AND the VECTOR(n) width declared in
# db/schema_init.sql. The service refuses to start embedding on a mismatch.
EMBEDDING_DIM=768

# Texts per forward pass. Higher is faster until memory runs out; 32 is safe
# on a 4 GB GPU for base-sized models.
EMBEDDING_BATCH_SIZE=32

# auto | cpu | cuda
EMBEDDING_DEVICE=auto
